* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #102416;
  color: #effff2;
  font-family: Arial, sans-serif;
}

.tarjeta {
  width: 100%;
  max-width: 460px;
  padding: 20px;
  border-radius: 18px;
  background: #193821;
  text-align: center;
}

h1 {
  margin-top: 0;
  color: #9bf081;
}

.marcador {
  font-size: 22px;
  font-weight: bold;
}

canvas {
  display: block;
  width: 100%;
  height: auto;
  border: 3px solid #9bf081;
  border-radius: 8px;
  background: #0b170e;
}

button {
  min-height: 48px;
  padding: 12px 18px;
  border: none;
  border-radius: 10px;
  background: #9bf081;
  color: #102416;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  touch-action: manipulation;
}

button:hover {
  background: #bcffa7;
}

button:focus-visible {
  outline: 3px solid white;
  outline-offset: 3px;
}

#iniciar {
  width: 100%;
}

.controles {
  display: grid;
  grid-template-columns: repeat(3, 60px);
  grid-template-rows: repeat(2, 52px);
  gap: 8px;
  justify-content: center;
  margin-top: 20px;
}

.arriba {
  grid-column: 2;
  grid-row: 1;
}

.izquierda {
  grid-column: 1;
  grid-row: 2;
}

.abajo {
  grid-column: 2;
  grid-row: 2;
}

.derecha {
  grid-column: 3;
  grid-row: 2;
}

.ayuda {
  color: #c4dcca;
  font-size: 14px;
  line-height: 1.6;
}
